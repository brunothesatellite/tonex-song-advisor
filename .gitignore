# ── Build .NET ────────────────────────────────────────────────────────────────
bin/
obj/
artifacts/
*.user
*.suo
.vs/

# ── Bases TONEX (bibliothèque personnelle, non versionnées) ───────────────────
# Pour lancer les tests : copier ta propre Library.db / Library2.db dans db/.
db/*.db
db/*.db-shm
db/*.db-wal

# ── Secrets : jamais versionnés ───────────────────────────────────────────────
# La clé API vit normalement dans %APPDATA%\TonexAdvisor\config.json (hors dépôt).
# Ces motifs protègent contre une recopie accidentelle à l'intérieur du projet.
opencode-key.txt
config.json
*.config.json
*.secrets.json
.env
.env.*

# ── Divers ────────────────────────────────────────────────────────────────────
*.log
Thumbs.db
desktop.ini
.DS_Store
