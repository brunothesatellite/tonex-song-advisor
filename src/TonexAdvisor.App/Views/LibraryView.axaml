<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TonexAdvisor.App.ViewModels"
             xmlns:loc="using:TonexAdvisor.App.Localization"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="740"
             x:Class="TonexAdvisor.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <UserControl.Resources>
        <loc:FilterLabelConverter x:Key="FilterLabel" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="18,14,18,14">

        <!-- ── Filters ────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,170,170,230,Auto,Auto" ColumnSpacing="10">

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{loc:Loc Biblio.Recherche.Titre}" Classes="faint" />
                <TextBox Text="{Binding SearchText}"
                         PlaceholderText="{loc:Loc Biblio.Recherche.Placeholder}"
                         Classes="search" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{loc:Loc Biblio.Filtre.Categorie}" Classes="faint" />
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FilterLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="{loc:Loc Biblio.Filtre.Genre}" Classes="faint" />
                <ComboBox ItemsSource="{Binding Genres}"
                          SelectedItem="{Binding SelectedGenre}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FilterLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Text="{loc:Loc Biblio.Filtre.Dossier}" Classes="faint" />
                <ComboBox ItemsSource="{Binding Folders}"
                          SelectedItem="{Binding SelectedFolder}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FilterLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Text=" " Classes="faint" />
                <ToggleButton Classes="chip" IsChecked="{Binding OnlyFavorites}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="favStar" Width="11" Height="11" />
                        <TextBlock Text="{loc:Loc Biblio.Filtre.Favoris}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <StackPanel Grid.Column="5" Spacing="4">
                <TextBlock Text=" " Classes="faint" />
                <Button Command="{Binding ClearFiltersCommand}"
                        Content="{loc:Loc Biblio.Filtre.Reinitialiser}" />
            </StackPanel>
        </Grid>

        <!-- ── Summary ────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Summary}" Classes="dim" VerticalAlignment="Center" />
                <Border Classes="chip-static" IsVisible="{Binding KnobSettingsAvailable}">
                    <TextBlock Text="{loc:Loc Biblio.Chip.ReglagesDisponibles}" Classes="faint" />
                </Border>
                <Border Classes="chip-static warn" IsVisible="{Binding !KnobSettingsAvailable}">
                    <TextBlock Text="{loc:Loc Biblio.Chip.Generation2}" Classes="faint" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ── Grids + detail ─────────────────────────────────────────── -->
        <!--
            A DockPanel rather than a two-column Grid: Avalonia floors a star column at the
            natural width of its child, and a DataGrid naturally wants to be wide enough for all
            its columns. That pushed the detail panel off the right edge of the window. The
            docked card is placed from the final arrange size instead, so it can never drift.
        -->
        <DockPanel Grid.Row="2" LastChildFill="True">

            <!-- Detail panel -->
            <Border DockPanel.Dock="Right" Width="400" Classes="card" Padding="14">
                <Grid>
                    <ContentControl Content="{Binding DetailContent}" />

                    <StackPanel Spacing="6"
                                IsVisible="{Binding !HasDetail}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="280">
                        <TextBlock Text="{loc:Loc Biblio.Detail.Vide.Titre}" Classes="dim"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Loc Biblio.Detail.Vide.Texte}"
                                   Classes="faint" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                ClipToBounds: the DataGrid lays its columns out from its own measure pass and
                will happily paint past the width it was given, straight over the detail card.
            -->
            <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        Margin="0,0,12,0"
                        ClipToBounds="True">

                <TabItem Header="{loc:Loc Biblio.Presets}">
                    <DataGrid x:Name="PresetsGrid" ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Loc Biblio.Col.Fav}" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PresetRowViewModel">
                                        <Panel>
                                            <Path Classes="favStar" ToolTip.Tip="{loc:Loc Biblio.Tooltip.Favori}" />
                                            <Path Classes="favStar favOff"
                                                  IsVisible="{Binding Favorite, Converter={x:Static converters:BoolConverters.Not}}" />
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Nom}" Binding="{Binding Name}"
                                                Width="1.7*" MinWidth="150" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Categorie}" Binding="{Binding Category}" Width="104" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Genre}" Binding="{Binding Genre}" Width="96" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Artiste}" Binding="{Binding Artist}" Width="132" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Chanson}" Binding="{Binding Song}" Width="124" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Stomp}" Binding="{Binding Stomp}"
                                                Width="1.3*" MinWidth="110" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Ampli}" Binding="{Binding Amp}"
                                                Width="1.3*" MinWidth="110" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Baffle}" Binding="{Binding Cab}"
                                                Width="1.3*" MinWidth="110" />
                            <DataGridTemplateColumn Header="{loc:Loc Biblio.Col.Reglages}" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PresetRowViewModel">
                                        <Panel>
                                            <Path Classes="checkGlyph"
                                                  ToolTip.Tip="{loc:Loc Biblio.Tooltip.ReglagesExploitables}"
                                                  IsVisible="{Binding HasSettings}" />
                                            <Path Classes="checkGlyph checkOff"
                                                  ToolTip.Tip="{loc:Loc Biblio.Tooltip.AucunReglage}"
                                                  IsVisible="{Binding HasSettings, Converter={x:Static converters:BoolConverters.Not}}" />
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="{loc:Loc Biblio.Onglet.ToneModels}">
                    <DataGrid x:Name="ToneModelsGrid" ItemsSource="{Binding ToneModels}"
                              SelectedItem="{Binding SelectedToneModel}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Loc Biblio.Col.Fav}" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:ToneModelRowViewModel">
                                        <Panel>
                                            <Path Classes="favStar" ToolTip.Tip="{loc:Loc Biblio.Tooltip.Favori}" />
                                            <Path Classes="favStar favOff"
                                                  IsVisible="{Binding Favorite, Converter={x:Static converters:BoolConverters.Not}}" />
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Nom}" Binding="{Binding Name}"
                                                Width="1.5*" MinWidth="140" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Stomp}" Binding="{Binding Stomp}"
                                                Width="1.3*" MinWidth="110" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Ampli}" Binding="{Binding Amp}"
                                                Width="1.4*" MinWidth="120" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Baffle}" Binding="{Binding Cab}"
                                                Width="1.4*" MinWidth="120" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Micros}" Binding="{Binding Mics}" Width="104" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Categorie}" Binding="{Binding Category}" Width="104" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Col.Type}" Binding="{Binding Kind}" Width="100" />
                            <DataGridTextColumn Header="{loc:Loc Biblio.Presets}" Binding="{Binding PresetCount}" Width="62" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="{loc:Loc Biblio.Onglet.Conseils}">
                    <ScrollViewer>
                        <StackPanel Spacing="12" Margin="4,10,4,4">

                            <!-- ── Query ─────────────────────────────────── -->
                            <Border Classes="card" Padding="12">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="{loc:Loc Conseil.Requete.Artiste}" Classes="faint" />
                                            <TextBox Text="{Binding Advice.Artist}"
                                                     PlaceholderText="{loc:Loc Conseil.Requete.PlaceholderArtiste}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{loc:Loc Conseil.Requete.Chanson}" Classes="faint" />
                                            <TextBox Text="{Binding Advice.Song}"
                                                     PlaceholderText="{loc:Loc Conseil.Requete.PlaceholderChanson}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="{loc:Loc Conseil.Requete.Style}" Classes="faint" />
                                            <TextBox Text="{Binding Advice.Style}"
                                                     PlaceholderText="{loc:Loc Conseil.Requete.PlaceholderStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Button Grid.Column="0" Classes="accent"
                                                Command="{Binding Advice.AdviseCommand}"
                                                Content="{loc:Loc Conseil.Bouton.Conseiller}" />
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Advice.Hint}"
                                                   Classes="faint" FontSize="11"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Classes="chip-static warn" HorizontalAlignment="Stretch"
                                            IsVisible="{Binding Advice.HasError}">
                                        <TextBlock Text="{Binding Advice.ErrorMessage}"
                                                   TextWrapping="Wrap" FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ── Ranked presets ────────────────────────── -->
                            <StackPanel Spacing="6" IsVisible="{Binding Advice.HasPresets}">
                                <TextBlock Text="{loc:Loc Conseil.Presets.Titre}" Classes="faint" />

                                <ItemsControl ItemsSource="{Binding Advice.Presets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AdvicePresetRowViewModel">
                                            <Border Classes="card" Padding="12" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                    <Border Grid.Column="0" Classes="chip-static"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding ScoreLabel}"
                                                                   Classes="accent" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" Classes="h2" />
                                                            <TextBlock Text="{Binding Artist}" Classes="faint"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Meta}" Classes="dim"
                                                                   FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding ReasonsText}" Classes="faint"
                                                                   FontSize="11" TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2" VerticalAlignment="Top"
                                                            Command="{Binding OpenCommand}"
                                                            Content="{loc:Loc Action.Ouvrir}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ── Best combination ──────────────────────── -->
                            <StackPanel Spacing="6" IsVisible="{Binding Advice.HasCombination}">
                                <TextBlock Text="{loc:Loc Conseil.Combination.Titre}"
                                           Classes="faint" />
                                <TextBlock Text="{loc:Loc Conseil.Combination.Texte}"
                                           Classes="dim" FontSize="11" TextWrapping="Wrap" />

                                <Border Classes="card" Padding="12"
                                        DataContext="{Binding Advice.Combination}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="5">
                                            <TextBlock Text="{Binding Block}" Classes="h2"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CabLine}" Classes="accent"
                                                       FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Usage}" Classes="faint"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding ReasonsText}" Classes="faint"
                                                       FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                                            <Border Classes="chip-static">
                                                <TextBlock Text="{Binding ScoreLabel}" Classes="accent" />
                                            </Border>
                                            <Button Command="{Binding OpenCommand}"
                                                    Content="{loc:Loc Action.Ouvrir}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ── Conseil IA ─────────────────────────────── -->
                            <Border Classes="card" Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="{loc:Loc Conseil.Avis.Titre}" Classes="faint" />
                                            <TextBlock Text="{loc:Loc Conseil.Avis.Texte}"
                                                       Classes="dim" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Classes="accent"
                                                    Command="{Binding Advice.AskAiCommand}"
                                                    IsEnabled="{Binding Advice.IsAiEnabled}"
                                                    Content="{loc:Loc Conseil.Bouton.DemanderIA}" />
                                            <Button Command="{Binding Advice.CancelAiCommand}"
                                                    IsVisible="{Binding Advice.IsAiBusy}"
                                                    Content="{loc:Loc Conseil.Bouton.Annuler}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Advice.AiStatus}" Classes="chip-static warn"
                                               FontSize="12" TextWrapping="Wrap"
                                               IsVisible="{Binding Advice.HasAiStatus}" />

                                    <ItemsControl ItemsSource="{Binding Advice.Opinions}"
                                                  IsVisible="{Binding Advice.HasOpinions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AiOpinionRowViewModel">
                                                <Border Classes="card" Padding="10" Margin="0,0,0,6">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <TextBlock Grid.Column="0" Text="{Binding Provider}"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       VerticalAlignment="Center" />

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        Spacing="8" VerticalAlignment="Center">
                                                                <!-- La voix travaille : on l'annonce au lieu de ne rien montrer. -->
                                                                <!-- Anneau anime par le code : une barre d'Avalonia se fige quand son onglet est decharge. -->
                                                                <Ellipse Tag="spinner" Width="13" Height="13"
                                                                         Stroke="{StaticResource B.Accent}"
                                                                         StrokeThickness="3" StrokeDashArray="6,4"
                                                                         RenderTransformOrigin="50%,50%"
                                                                         IsVisible="{Binding IsPending}"
                                                                         VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ElapsedLabel}"
                                                                           Classes="faint" FontSize="11"
                                                                           VerticalAlignment="Center" />

                                                                <TextBlock Text="{Binding Status}" Classes="faint"
                                                                           FontSize="11" VerticalAlignment="Center"
                                                                           IsVisible="{Binding ShowPlainStatus}" />

                                                                <!-- Erreur : compacte, mais le détail se déplie au clic. -->
                                                                <Button Content="{Binding Status}"
                                                                        Command="{Binding ToggleErrorCommand}"
                                                                        FontSize="11" Padding="8,1"
                                                                        IsVisible="{Binding HasError}"
                                                                        ToolTip.Tip="{loc:Loc Conseil.Tooltip.VoirErreur}" />

                                                                <!-- Sortie complète du modèle, même bouton : le travail, pas la réponse. -->
                                                                <Button Content="{loc:Loc Conseil.Bouton.Thinking}"
                                                                        Command="{Binding ToggleThinkingCommand}"
                                                                        FontSize="11" Padding="8,1"
                                                                        IsVisible="{Binding CanToggleThinking}"
                                                                        ToolTip.Tip="{loc:Loc Conseil.Tooltip.VoirThinking}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{Binding Lines}"
                                                                      IsVisible="{Binding HasText}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:AnswerLineViewModel">
                                                                    <!-- SelectableTextBlock : lecture seule, mais la souris sélectionne et copie. -->
                                                                    <SelectableTextBlock TextWrapping="Wrap" FontSize="11">
                                                                        <Run Text="{Binding Label}"
                                                                             Foreground="{StaticResource B.Accent}" />
                                                                        <Run Text="{Binding Body}" />
                                                                    </SelectableTextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- La reflexion : masquee tant qu on ne l a pas demandee. -->
                                                        <SelectableTextBlock Text="{Binding Thinking}" Classes="faint"
                                                                   FontStyle="Italic" FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding HasThinking}" />

                                                        <SelectableTextBlock Text="{Binding ErrorDetail}" Classes="faint"
                                                                   FontSize="11" TextWrapping="Wrap"
                                                                   IsVisible="{Binding IsErrorExpanded}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <SelectableTextBlock Text="{Binding Advice.AiThinking}" Classes="faint"
                                               FontStyle="Italic" FontSize="11" TextWrapping="Wrap"
                                               IsVisible="{Binding Advice.HasAiThinking}" />


                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            <Ellipse Tag="spinner" Width="15" Height="15"
                                                     Stroke="{StaticResource B.Accent}"
                                                     StrokeThickness="3" StrokeDashArray="6,4"
                                                     RenderTransformOrigin="50%,50%"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding Advice.IsArbitreWorking}" />
                                             <TextBlock Text="{loc:Loc Conseil.Arbitre.Tranche}" Classes="faint" FontSize="11"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding Advice.IsArbitreWorking}" />
                                             <TextBlock Text="{Binding Advice.ArbitreElapsedLabel}"
                                                        Classes="faint" FontSize="11"
                                                        VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Advice.AiTitle}" Classes="faint"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       IsVisible="{Binding Advice.HasAiTitle}" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="{loc:Loc Conseil.Bouton.Thinking}" FontSize="11"
                                                Padding="8,1"
                                                Command="{Binding Advice.ToggleAiThinkingCommand}"
                                                IsVisible="{Binding Advice.CanToggleAiThinking}"
                                                ToolTip.Tip="{loc:Loc Conseil.Tooltip.VoirReflexionArbitre}" />
                                    </Grid>


                                    <ItemsControl ItemsSource="{Binding Advice.AiLines}"
                                                  IsVisible="{Binding Advice.HasAiLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AnswerLineViewModel">
                                                <!-- Lecture seule par nature : le verdict se sélectionne à la souris
                                                     et se copie (Ctrl+C) pour être collé ailleurs. -->
                                                <SelectableTextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21">
                                                    <Run Text="{Binding Label}"
                                                         Foreground="{StaticResource B.Accent}" />
                                                    <Run Text="{Binding Body}" />
                                                </SelectableTextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

        </DockPanel>

    </Grid>

</UserControl>
