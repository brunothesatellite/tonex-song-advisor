<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TonexAdvisor.App.ViewModels"
             xmlns:loc="using:TonexAdvisor.App.Localization"
             xmlns:config="using:TonexAdvisor.App.Config"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="740"
             x:Class="TonexAdvisor.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <loc:LanguageLabelConverter x:Key="LanguageLabel" />
    </UserControl.Resources>

    <ScrollViewer Padding="18,14">
        <StackPanel Spacing="14" MaxWidth="880" HorizontalAlignment="Left">

            <StackPanel Spacing="3">
                <TextBlock Text="{loc:Loc Reglages.Bases.Titre}" Classes="h1" />
                <TextBlock Text="{loc:Loc Reglages.Bases.Intro}"
                           Classes="dim" />
            </StackPanel>

            <!-- ── Langue de l'interface (§11) ─────────────────────────── -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc Reglages.Langue.Titre}" Classes="faint" />
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="12">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding LanguageCodes}"
                                  SelectedItem="{Binding UiLanguage}"
                                  HorizontalAlignment="Stretch">
                            <!-- Le gabarit se ré-exécute à la bascule : les cellules sont
                                 recréées par la VM, la valeur transportée reste le code. -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource LanguageLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc Reglages.Langue.Immediat}"
                                   Classes="faint" FontSize="11"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Path + actions ──────────────────────────────────────── -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc Reglages.Bases.Carte.Titre}" Classes="faint" />

                    <!-- Choix 2 : les bases du dossier officiel. -->
                    <StackPanel Spacing="6">
                        <CheckBox IsChecked="{Binding UseTonexLibrary}"
                                  IsEnabled="{Binding CanUseTonex}"
                                  Content="{loc:Loc Reglages.Bases.Carte.Utiliser}" />
                        <ComboBox ItemsSource="{Binding TonexLibraries}"
                                  SelectedItem="{Binding SelectedTonexLibrary}"
                                  IsEnabled="{Binding IsTonexEnabled}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="{loc:Loc Reglages.Bases.Carte.Choisir}" />
                        <TextBlock Text="{Binding TonexFolderHint}" Classes="faint"
                                   FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Choix 1 : le chemin, inactif quand la liste est utilisée. -->

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
                          IsEnabled="{Binding IsManualEnabled}">
                        <TextBox Grid.Column="0"
                                 Text="{Binding DatabasePath}"
                                 PlaceholderText="{loc:Loc Reglages.Bases.Carte.Placeholder}" />
                        <Button Grid.Column="1" Click="OnBrowseClick"
                                Content="{loc:Loc Reglages.Bouton.Parcourir}" />
                        <Button Grid.Column="2" Classes="accent"
                                Command="{Binding LoadCommand}"
                                Content="{loc:Loc Reglages.Bouton.Ouvrir}" />
                    </Grid>

                    <Border Classes="chip-static warn"
                            HorizontalAlignment="Stretch"
                            Padding="10,7"
                            IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Read-only guarantee ─────────────────────────────────── -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="chip-static on">
                            <TextBlock Text="{loc:Loc Reglages.LectureSeule.Pastille}" Classes="faint" />
                        </Border>
                        <TextBlock Text="{loc:Loc Reglages.LectureSeule.Titre}" Classes="h2" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ReadOnlyNotice}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── AI : OpenCode Go ─────────────────────────────────────── -->
            <StackPanel Spacing="3">
                <TextBlock Text="{loc:Loc Reglages.IA.Titre}" Classes="h1" />
                <TextBlock Text="{loc:Loc Reglages.IA.Intro}"
                           Classes="dim" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="9">
                    <TextBlock Text="{loc:Loc Reglages.IA.Cle.Titre}" Classes="faint" />
                    <TextBox Text="{Binding ApiKey}"
                             PasswordChar="*"
                             PlaceholderText="{loc:Loc Reglages.IA.Cle.Placeholder}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="{loc:Loc Reglages.IA.Arbitre.Titre}" Classes="faint" />
                            <ComboBox ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="{loc:Loc Reglages.IA.Arbitre.Placeholder}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="config:OpenCodeModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Id}" />
                                            <TextBlock Text="·" Classes="faint" />
                                            <TextBlock Text="{Binding Tag}"
                                                       Classes.free="{Binding IsFree}"
                                                       Classes.paid="{Binding IsPaid}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Bottom"
                                Command="{Binding RefreshModelsCommand}"
                                IsEnabled="{Binding CanRefreshModels}"
                                Content="{loc:Loc Reglages.Bouton.MiseAJour}" />
                    </Grid>

                    <Border Classes="chip-static" Padding="10,7" HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasModelStatus}">
                        <TextBlock Text="{Binding ModelStatus}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Classes="accent"
                                Command="{Binding SaveAiCommand}"
                                Content="{loc:Loc Reglages.Bouton.Enregistrer}" />
                        <Button Grid.Column="1"
                                Command="{Binding TestAiCommand}"
                                IsEnabled="{Binding !IsTestingAi}"
                                Content="{loc:Loc Reglages.Bouton.TesterConnexion}" />
                    </Grid>

                    <Border Classes="chip-static" Padding="10,7" HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasAiStatus}">
                        <TextBlock Text="{Binding AiStatusMessage}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding ConfigPath}" Classes="faint" FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                               Text="{loc:Loc Reglages.IA.Tarif}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Avis croises : voix challengeres (facultatif) -->
            <StackPanel Spacing="3">
                <TextBlock Text="{loc:Loc Reglages.Avis.Titre}" Classes="h1" />
                <TextBlock Text="{loc:Loc Reglages.Avis.Intro}"
                           Classes="dim" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="9">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc Reglages.Avis.Voix.Titre}" Classes="faint" />
                            <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                       Text="{loc:Loc Reglages.Avis.Voix.Intro}" />

                            <ItemsControl ItemsSource="{Binding VoiceChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VoiceChoiceViewModel">
                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <Border Classes="chip-static" Classes.free="{Binding IsFree}" Classes.paid="{Binding IsPaid}" Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Tag}" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Classes="chip-static warn" Padding="10,7" HorizontalAlignment="Stretch"
                                    IsVisible="{Binding HasVoiceModelsStatus}">
                                <TextBlock Text="{Binding VoiceModelsStatus}" TextWrapping="Wrap" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:Loc Reglages.Avis.Cles.Titre}" Classes="faint" />

                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding GeminiActive}" Content="{loc:Loc Reglages.Presse.Gemini}"
                                  VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding GeminiKey}" PasswordChar="*"
                                     PlaceholderText="{loc:Loc Reglages.Presse.Gemini.Placeholder}" />
                            <TextBlock Grid.Column="2" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="{loc:Loc Reglages.Presse.Gemini.Lien}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="{Binding GeminiModelHint}" />
                            <TextBox Grid.Column="1" Text="{Binding GeminiModel}" FontSize="11"
                                     PlaceholderText="{Binding GeminiDefaultModel}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding MistralActive}" Content="{loc:Loc Reglages.Presse.Mistral}"
                                   VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding MistralKey}" PasswordChar="*"
                                     PlaceholderText="..." />
                            <TextBlock Grid.Column="2" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="{loc:Loc Reglages.Presse.Mistral.Lien}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="{Binding MistralModelHint}" />
                            <TextBox Grid.Column="1" Text="{Binding MistralModel}" FontSize="11"
                                     PlaceholderText="{Binding MistralDefaultModel}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding GroqActive}" Content="{loc:Loc Reglages.Presse.Groq}"
                                VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding GroqKey}" PasswordChar="*"
                                     PlaceholderText="{loc:Loc Reglages.Presse.Groq.Placeholder}" />
                            <TextBlock Grid.Column="2" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="{loc:Loc Reglages.Presse.Groq.Lien}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="{Binding GroqModelHint}" />
                            <TextBox Grid.Column="1" Text="{Binding GroqModel}" FontSize="11"
                                     PlaceholderText="{Binding GroqDefaultModel}" />
                        </Grid>
                    </StackPanel>

                    <Button Classes="accent" HorizontalAlignment="Left"
                            Command="{Binding TestProvidersCommand}"
                            IsEnabled="{Binding !IsTestingAi}"
                            Content="{loc:Loc Reglages.Bouton.TesterVoix}" />

                    <Border Classes="chip-static" Padding="10,7" HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasProviderStatus}">
                        <TextBlock Text="{Binding ProviderStatus}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                               Text="{loc:Loc Reglages.Avis.ClesNote}" />
                </StackPanel>
            </Border>

            <!-- ── What was opened ─────────────────────────────────────── -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Loc Reglages.Ouvert.Titre}" Classes="faint" />

                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="12" RowSpacing="7">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Reglages.Ouvert.Format}" Classes="dim" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FormatLabel}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Reglages.Ouvert.Fichier}" Classes="dim" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileLabel}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Reglages.Ouvert.Contenu}" Classes="dim" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CountsLabel}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Reglages.Ouvert.Reglages}" Classes="dim" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SettingsLabel}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Reglages.Ouvert.Sha}" Classes="dim" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HashLabel}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Reglages.Ouvert.Tables}" Classes="dim" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TablesLabel}"
                                   Classes="faint" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Version differences ─────────────────────────────────── -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc Reglages.Differences.Titre}" Classes="faint" />
                    <TextBlock Text="{Binding FormatHint}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
