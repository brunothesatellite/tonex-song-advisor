<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TonexAdvisor.App.ViewModels"
             xmlns:config="using:TonexAdvisor.App.Config"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="740"
             x:Class="TonexAdvisor.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="18,14">
        <StackPanel Spacing="14" MaxWidth="880" HorizontalAlignment="Left">

            <StackPanel Spacing="3">
                <TextBlock Text="Bases TONEX" Classes="h1" />
                <TextBlock Text="L'application lit vos bibliothèques ; elle n'y écrit jamais."
                           Classes="dim" />
            </StackPanel>

            <!-- ── Path + actions ──────────────────────────────────────── -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="BIBLIOTHÈQUE TONEX" Classes="faint" />

                    <!-- Choix 2 : les bases du dossier officiel. -->
                    <StackPanel Spacing="6">
                        <CheckBox IsChecked="{Binding UseTonexLibrary}"
                                  IsEnabled="{Binding CanUseTonex}"
                                  Content="Utiliser une base du dossier TONEX" />
                        <ComboBox ItemsSource="{Binding TonexLibraries}"
                                  SelectedItem="{Binding SelectedTonexLibrary}"
                                  IsEnabled="{Binding IsTonexEnabled}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Choisir une base du dossier TONEX" />
                        <TextBlock Text="{Binding TonexFolderHint}" Classes="faint"
                                   FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Choix 1 : le chemin, inactif quand la liste est utilisée. -->

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
                          IsEnabled="{Binding IsManualEnabled}">
                        <TextBox Grid.Column="0"
                                 Text="{Binding DatabasePath}"
                                 PlaceholderText="C:\…\TONEX\Library.db ou Library2.db" />
                        <Button Grid.Column="1" Click="OnBrowseClick">Parcourir…</Button>
                        <Button Grid.Column="2" Classes="accent"
                                Command="{Binding LoadCommand}">Ouvrir</Button>
                    </Grid>

                    <Border Classes="chip-static warn"
                            HorizontalAlignment="Stretch"
                            Padding="10,7"
                            IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Read-only guarantee ─────────────────────────────────── -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="chip-static on">
                            <TextBlock Text="LECTURE SEULE" Classes="faint" />
                        </Border>
                        <TextBlock Text="Garantie technique" Classes="h2" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ReadOnlyNotice}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── AI : OpenCode Go ─────────────────────────────────────── -->
            <StackPanel Spacing="3">
                <TextBlock Text="Conseil IA" Classes="h1" />
                <TextBlock Text="Le conseil s'appuie sur l'API OpenCode Go : la liste des modèles, gratuits comme payants, vient de votre clé."
                           Classes="dim" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="9">
                    <TextBlock Text="CLÉ API OPENCODE" Classes="faint" />
                    <TextBox Text="{Binding ApiKey}"
                             PasswordChar="*"
                             PlaceholderText="oc_sk_…" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="MODÈLE ARBITRE (gratuits et payants)" Classes="faint" />
                            <ComboBox ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Choisir un modèle">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="config:OpenCodeModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Id}" />
                                            <TextBlock Text="·" Classes="faint" />
                                            <TextBlock Text="{Binding Tag}"
                                                       Classes.free="{Binding IsFree}"
                                                       Classes.paid="{Binding IsPaid}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Bottom"
                                Command="{Binding RefreshModelsCommand}"
                                IsEnabled="{Binding CanRefreshModels}">Mise à jour</Button>
                    </Grid>

                    <Border Classes="chip-static" Padding="10,7" HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasModelStatus}">
                        <TextBlock Text="{Binding ModelStatus}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Classes="accent"
                                Command="{Binding SaveAiCommand}">Enregistrer</Button>
                        <Button Grid.Column="1"
                                Command="{Binding TestAiCommand}"
                                IsEnabled="{Binding !IsTestingAi}">Tester la connexion</Button>
                    </Grid>

                    <Border Classes="chip-static" Padding="10,7" HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasAiStatus}">
                        <TextBlock Text="{Binding AiStatusMessage}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding ConfigPath}" Classes="faint" FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                               Text="Le tarif « Free » d'OpenCode Go est limité dans le temps ; le free tier « Personnel » n'est pas accessible depuis une application tierce (403). Le choix du modèle vous appartient." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Avis croises : voix challengeres (facultatif) -->
            <StackPanel Spacing="3">
                <TextBlock Text="Avis croisés" Classes="h1" />
                <TextBlock Text="Renseignez les clés que vous souhaitez : chaque voix donne son avis et peut contredire la référence, puis un arbitre classe les 3 meilleures propositions."
                           Classes="dim" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="9">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="VOIX OPENCODE - 1 OU PLUSIEURS MODELES" Classes="faint" />
                            <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap"
                                       Text="Ces modeles donnent leur avis en meme temps que les voix gratuites, puis l'arbitre tranche. Un modele peut etre a la fois voix et arbitre." />

                            <ItemsControl ItemsSource="{Binding VoiceChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VoiceChoiceViewModel">
                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <Border Classes="chip-static" Classes.free="{Binding IsFree}" Classes.paid="{Binding IsPaid}" Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Tag}" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Classes="chip-static warn" Padding="10,7" HorizontalAlignment="Stretch"
                                    IsVisible="{Binding HasVoiceModelsStatus}">
                                <TextBlock Text="{Binding VoiceModelsStatus}" TextWrapping="Wrap" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CLÉS GEMINI / MISTRAL / GROQ (FACULTATIVES)" Classes="faint" />

                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding GeminiActive}" Content="Gemini"
                                  VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding GeminiKey}" PasswordChar="*"
                                     PlaceholderText="AIza..." />
                            <TextBlock Grid.Column="2" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="aistudio.google.com/apikey" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="{Binding GeminiModelHint}" />
                            <TextBox Grid.Column="1" Text="{Binding GeminiModel}" FontSize="11"
                                     PlaceholderText="{Binding GeminiDefaultModel}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding MistralActive}" Content="Mistral"
                                   VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding MistralKey}" PasswordChar="*"
                                     PlaceholderText="..." />
                            <TextBlock Grid.Column="2" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="console.mistral.ai/api-keys" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="{Binding MistralModelHint}" />
                            <TextBox Grid.Column="1" Text="{Binding MistralModel}" FontSize="11"
                                     PlaceholderText="{Binding MistralDefaultModel}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding GroqActive}" Content="Groq"
                                VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding GroqKey}" PasswordChar="*"
                                     PlaceholderText="gsk_..." />
                            <TextBlock Grid.Column="2" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="console.groq.com/keys" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Classes="faint" FontSize="11"
                                       VerticalAlignment="Center" Text="{Binding GroqModelHint}" />
                            <TextBox Grid.Column="1" Text="{Binding GroqModel}" FontSize="11"
                                     PlaceholderText="{Binding GroqDefaultModel}" />
                        </Grid>
                    </StackPanel>

                    <Button Classes="accent" HorizontalAlignment="Left"
                            Command="{Binding TestProvidersCommand}"
                            IsEnabled="{Binding !IsTestingAi}">Tester les voix</Button>

                    <Border Classes="chip-static" Padding="10,7" HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasProviderStatus}">
                        <TextBlock Text="{Binding ProviderStatus}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                               Text="Aucune clé n'est versionnée : elles sont stockées dans le même fichier hors dépôt. Une clé absente = une voix silencieuse, et le conseil reste valable sans elle." />
                </StackPanel>
            </Border>

            <!-- ── What was opened ─────────────────────────────────────── -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="CONTENU OUVERT" Classes="faint" />

                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="12" RowSpacing="7">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Format" Classes="dim" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FormatLabel}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fichier" Classes="dim" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileLabel}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Contenu" Classes="dim" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CountsLabel}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Réglages" Classes="dim" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SettingsLabel}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="SHA-256" Classes="dim" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HashLabel}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Tables" Classes="dim" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TablesLabel}"
                                   Classes="faint" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Version differences ─────────────────────────────────── -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="DIFFÉRENCES ENTRE GÉNÉRATIONS" Classes="faint" />
                    <TextBlock Text="{Binding FormatHint}" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
